<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title><%= selectedId.name %> | PIGI</title>

    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/output.css">
</head>

<body class="bg-gray-50 text-gray-900 min-h-screen flex flex-col antialiased selection:bg-indigo-100 selection:text-indigo-700">

    <!-- Ambient background light -->
    <div class="fixed inset-0 overflow-hidden pointer-events-none -z-10">
        <div class="absolute -top-40 right-10 w-[55rem] h-[55rem] bg-indigo-50/70 rounded-full blur-3xl"></div>
    </div>

    <!-- Header / Navbar -->
    <header class="bg-white/90 backdrop-blur-md border-b border-gray-200/80 sticky top-0 z-40 transition-all">
        <div class="max-w-7xl mx-auto px-4 sm:px-8 h-18 flex items-center justify-between py-3.5">

            <a href="/" class="flex items-center gap-2.5 group">

                <div class="w-9 h-9 rounded-xl bg-indigo-600 flex items-center justify-center text-white font-black text-lg shadow-sm shadow-indigo-200 group-hover:bg-indigo-700 transition">
                    P
                </div>

                <div class="flex flex-col">
                    <span class="text-xl font-extrabold tracking-tight text-gray-900 group-hover:text-indigo-600 transition leading-none">
                        PIGI
                    </span>

                    <span class="text-[10px] tracking-wider font-semibold text-gray-400 uppercase mt-0.5">
                        Stay Simple
                    </span>
                </div>

            </a>

            <div class="flex items-center gap-4">

                <a href="/" class="text-sm font-semibold text-gray-600 hover:text-indigo-600 transition flex items-center gap-2 px-3 py-1.5 rounded-lg hover:bg-gray-100">

                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
                    </svg>

                    <span>All Listings</span>

                </a>

            </div>

        </div>
    </header>


    <!-- Main Full-Width Content -->
    <main class="flex-1 max-w-7xl mx-auto px-4 sm:px-8 py-8 w-full">

        <!-- Title & Location Header Bar -->
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 pb-6 mb-6 border-b border-gray-200">

            <div>

                <div class="flex items-center gap-2 mb-2">

                    <span class="inline-flex items-center gap-1.5 bg-emerald-50 text-emerald-700 border border-emerald-200 text-xs font-bold uppercase tracking-wider px-2.5 py-0.5 rounded-full">

                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>

                        Available Now

                    </span>

                    <span class="text-xs font-semibold text-gray-400">
                        • Verified Property
                    </span>

                </div>

                <h1 class="text-3xl sm:text-4xl md:text-5xl font-black tracking-tight text-gray-900">
                    <%= selectedId.name %>
                </h1>

                <p class="text-sm sm:text-base text-gray-600 flex items-center gap-2 mt-2">

                    <svg class="w-4 h-4 text-indigo-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">

                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />

                        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />

                    </svg>

                    <span class="font-medium">
                        <%= selectedId.location %>
                    </span>

                </p>

            </div>

            <!-- Header Quick Price -->
            <div class="text-left md:text-right">

                <span class="text-xs font-bold text-gray-400 uppercase tracking-wider">
                    Starts at
                </span>

                <div class="text-3xl sm:text-4xl font-black text-indigo-600">
                    ₹<%= selectedId.price %>
                    <span class="text-sm font-medium text-gray-400">
                        / month
                    </span>
                </div>

            </div>

        </div>


        <!-- Full-Width Media Gallery Grid -->
        <section class="grid grid-cols-1 md:grid-cols-3 gap-3 mb-10 h-72 sm:h-96 md:h-[460px] rounded-3xl overflow-hidden shadow-md">

            <!-- Main Hero Image -->
            <div class="md:col-span-2 relative h-full bg-gray-200 overflow-hidden group">

                <img
                    src="/img.jpg"
                    alt="<%= selectedId.name %>"
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    onerror="this.classList.add('hidden'); this.nextElementSibling.classList.remove('hidden');"
                >

                <div class="hidden w-full h-full flex flex-col items-center justify-center bg-gray-100 text-gray-400">

                    <svg class="w-16 h-16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">

                        <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 001.5-1.5V6a1.5 1.5 0 00-1.5-1.5H3.75A1.5 1.5 0 002.25 6v12a1.5 1.5 0 001.5 1.5zm10.5-11.25h.008v.008h-.008V8.25zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z" />

                    </svg>

                    <span class="text-sm mt-2 font-medium">
                        Primary Room Photo
                    </span>

                </div>

                <div class="absolute bottom-4 left-4 bg-black/60 backdrop-blur-md text-white text-xs font-semibold px-3 py-1.5 rounded-xl">
                    📸 Main Living Area
                </div>

            </div>


            <!-- Secondary Sub-Images Stack -->
            <div class="hidden md:grid grid-rows-2 gap-3 h-full">

                <div class="relative bg-gray-200 overflow-hidden group">

                    <img
                        src="/img.jpg"
                        alt="Amenities"
                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 filter brightness-95"
                    >

                    <div class="absolute bottom-3 left-3 bg-black/60 backdrop-blur-md text-white text-[11px] font-medium px-2.5 py-1 rounded-lg">
                        Bedroom & Study
                    </div>

                </div>


                <div class="relative bg-indigo-900 overflow-hidden group">

                    <img
                        src="/img.jpg"
                        alt="Washroom / Dining"
                        class="w-full h-full object-cover opacity-80 group-hover:scale-105 transition-transform duration-500"
                    >

                    <div class="absolute inset-0 bg-indigo-950/40 flex items-center justify-center">

                        <button class="bg-white/90 hover:bg-white text-gray-900 text-xs font-bold px-4 py-2 rounded-xl shadow-lg transition">
                            View All 8 Photos
                        </button>

                    </div>

                </div>

            </div>

        </section>


        <!-- 2-Column Split -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-10">

            <!-- Left 2 Cols -->
            <div class="lg:col-span-2 space-y-10">

                <!-- Highlights Cards -->
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">

                    <div class="bg-white p-4 rounded-2xl border border-gray-200/80 shadow-sm">
                        <span class="text-2xl">🛏️</span>
                        <h3 class="font-bold text-gray-900 mt-2 text-sm">Twin Sharing</h3>
                        <p class="text-xs text-gray-400 mt-0.5">Spacious wardrobes</p>
                    </div>

                    <div class="bg-white p-4 rounded-2xl border border-gray-200/80 shadow-sm">
                        <span class="text-2xl">⚡</span>
                        <h3 class="font-bold text-gray-900 mt-2 text-sm">300 Mbps WiFi</h3>
                        <p class="text-xs text-gray-400 mt-0.5">Dual-band fiber</p>
                    </div>

                    <div class="bg-white p-4 rounded-2xl border border-gray-200/80 shadow-sm">
                        <span class="text-2xl">🍲</span>
                        <h3 class="font-bold text-gray-900 mt-2 text-sm">Home Meals</h3>
                        <p class="text-xs text-gray-400 mt-0.5">3 times daily included</p>
                    </div>

                    <div class="bg-white p-4 rounded-2xl border border-gray-200/80 shadow-sm">
                        <span class="text-2xl">🛡️</span>
                        <h3 class="font-bold text-gray-900 mt-2 text-sm">Biometric Access</h3>
                        <p class="text-xs text-gray-400 mt-0.5">24/7 CCTV & guard</p>
                    </div>

                </div>


                <!-- Description -->
                <div class="bg-white p-6 sm:p-8 rounded-3xl border border-gray-200/80 shadow-sm">

                    <h2 class="text-xl font-extrabold text-gray-900 mb-3">
                        About this accommodation
                    </h2>

                    <p class="text-gray-600 leading-relaxed text-sm sm:text-base">

                        Experience hassle-free modern living designed specifically for students and working professionals.

                        Located right inside
                        <span class="font-semibold text-gray-900">
                            <%= selectedId.location %>
                        </span>,

                        this PG offers clean air-conditioned rooms, regular housekeeping, laundry support, high-speed fiber internet, and hygienic chef-cooked meals.

                    </p>

                    <div class="mt-6 pt-6 border-t border-gray-100 flex flex-wrap gap-4 text-xs font-semibold text-gray-600">

                        <span class="flex items-center gap-1.5 bg-gray-50 px-3 py-1.5 rounded-lg border border-gray-200">
                            ✔ Attached Washrooms
                        </span>

                        <span class="flex items-center gap-1.5 bg-gray-50 px-3 py-1.5 rounded-lg border border-gray-200">
                            ✔ Power Backup (24/7)
                        </span>

                        <span class="flex items-center gap-1.5 bg-gray-50 px-3 py-1.5 rounded-lg border border-gray-200">
                            ✔ RO Drinking Water
                        </span>

                        <span class="flex items-center gap-1.5 bg-gray-50 px-3 py-1.5 rounded-lg border border-gray-200">
                            ✔ Daily Housekeeping
                        </span>

                    </div>

                </div>


                <!-- House Rules -->
                <div class="bg-white p-6 sm:p-8 rounded-3xl border border-gray-200/80 shadow-sm">

                    <h2 class="text-xl font-extrabold text-gray-900 mb-4">
                        Things to know
                    </h2>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm text-gray-600">

                        <div class="flex items-start gap-3">
                            <span class="text-indigo-600 font-bold">⏱</span>

                            <div>
                                <p class="font-bold text-gray-800">Gate Timings</p>
                                <p class="text-xs text-gray-500 mt-0.5">
                                    Entry closes at 10:30 PM
                                </p>
                            </div>
                        </div>

                        <div class="flex items-start gap-3">
                            <span class="text-indigo-600 font-bold">📄</span>

                            <div>
                                <p class="font-bold text-gray-800">Notice Period</p>
                                <p class="text-xs text-gray-500 mt-0.5">
                                    30 days standard notice required
                                </p>
                            </div>
                        </div>

                        <div class="flex items-start gap-3">
                            <span class="text-indigo-600 font-bold">👥</span>

                            <div>
                                <p class="font-bold text-gray-800">Visitors</p>
                                <p class="text-xs text-gray-500 mt-0.5">
                                    Allowed in lounge until 8:00 PM
                                </p>
                            </div>
                        </div>

                        <div class="flex items-start gap-3">
                            <span class="text-indigo-600 font-bold">🚭</span>

                            <div>
                                <p class="font-bold text-gray-800">No Smoking</p>
                                <p class="text-xs text-gray-500 mt-0.5">
                                    100% smoke-free property
                                </p>
                            </div>
                        </div>

                    </div>

                </div>

            </div>


            <!-- Right Action Card -->
            <div class="lg:col-span-1">

                <div class="sticky top-24 bg-white rounded-3xl border border-gray-200/80 shadow-xl shadow-gray-200/60 p-6 sm:p-8">

                    <!-- Pricing Header -->
                    <div class="flex items-baseline justify-between pb-5 border-b border-gray-100">

                        <div>

                            <span class="text-xs uppercase font-bold tracking-wider text-gray-400 block">
                                Monthly Rent
                            </span>

                            <div class="text-3xl font-black text-indigo-600">
                                ₹<%= selectedId.price %>
                                <span class="text-sm font-medium text-gray-400">
                                    /mo
                                </span>
                            </div>

                        </div>

                        <span class="text-xs font-semibold px-2.5 py-1 bg-indigo-50 text-indigo-700 rounded-lg border border-indigo-100">
                            Zero Brokerage
                        </span>

                    </div>


                    <!-- Rent Breakdown -->
                    <div class="py-5 space-y-3 text-xs text-gray-600 border-b border-gray-100">

                        <div class="flex justify-between">
                            <span>Base Rent (Furnished)</span>
                            <span class="font-semibold text-gray-800">
                                ₹<%= selectedId.price %>
                            </span>
                        </div>

                        <div class="flex justify-between">
                            <span>Maintenance & WiFi</span>
                            <span class="font-semibold text-emerald-600">
                                Included
                            </span>
                        </div>

                        <div class="flex justify-between">
                            <span>Security Deposit</span>
                            <span class="font-semibold text-gray-800">
                                1 Month (Refundable)
                            </span>
                        </div>

                    </div>


                    <!-- Action Buttons -->
                    <div class="pt-6 space-y-3">

                        <!-- Contact Button -->
                        <a href="tel:+919876543210"
                            class="w-full py-3.5 px-4 bg-indigo-600 hover:bg-indigo-700 text-white font-bold rounded-2xl shadow-lg shadow-indigo-200 text-center block text-sm transition-all duration-200 hover:-translate-y-0.5 active:translate-y-0">
                            Schedule a Visit / Call Host
                        </a>


                        <!-- Favourite Buttons - Normal Users Only -->
                        <% if (user && user.role === 'user') { %>

                            <% if (isFavourite) { %>

                                <form action="/favourite/<%= selectedId.id %>" method="POST">

                                    <button type="submit"
                                        class="w-full py-3 px-4 bg-rose-50 hover:bg-rose-100/80 text-rose-600 border border-rose-200 font-semibold rounded-2xl text-center text-xs flex items-center justify-center gap-2 transition">

                                        <svg class="w-4 h-4 fill-rose-600" viewBox="0 0 24 24">

                                            <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>

                                        </svg>

                                        Remove from Favourites

                                    </button>

                                </form>

                            <% } else { %>

                                <form action="/favourite" method="POST">

                                    <button type="submit"
                                        class="w-full py-3 px-4 bg-white hover:bg-gray-50 text-gray-700 border border-gray-200 font-semibold rounded-2xl text-center text-xs flex items-center justify-center gap-2 transition hover:text-indigo-600">

                                        <svg class="w-4 h-4 fill-none stroke-current" viewBox="0 0 24 24" stroke-width="2">

                                            <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />

                                        </svg>

                                        Save to Favourites

                                    </button>

                                    <input type="hidden" name="id" value="<%= selectedId.id %>">

                                </form>

                            <% } %>

                        <% } %>


                        <!-- Host Management -->
                        <% if (isOwner) { %>

                            <div class="pt-4 mt-4 border-t border-gray-100 space-y-3">

                                <!-- Edit -->
                                <a href="/host/edit-listing/<%= selectedId.id %>"
                                    class="w-full py-2.5 px-3 bg-indigo-50 hover:bg-indigo-100 text-indigo-700 rounded-xl text-xs font-semibold flex items-center justify-center gap-1.5 transition">

                                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">

                                        <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.687a1.875 1.875 0 112.652 2.652l-1.687 1.687m-2.652-2.652L6.75 13.5V17.25H10.5L18.487 9.263m-1.625-4.776l2.652 2.652" />

                                    </svg>

                                    Edit this listing

                                </a>


                                <!-- Delete -->
                                <form action="/host/delete-listing/<%= selectedId.id %>" method="POST">

                                    <button type="submit"
                                        onclick="return confirm('Are you sure you want to delete this listing? This action cannot be undone.');"
                                        class="w-full py-2.5 px-3 text-rose-500 hover:text-rose-700 hover:bg-rose-50 rounded-xl text-xs font-semibold flex items-center justify-center gap-1.5 transition">

                                        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">

                                            <path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" />

                                        </svg>

                                        Delete this listing

                                    </button>

                                </form>

                            </div>

                        <% } %>

                    </div>

                </div>

            </div>

        </div>

    </main>


    <!-- Footer -->
    <footer class="bg-gray-900 text-gray-400 border-t border-gray-800 mt-20">

        <div class="max-w-7xl mx-auto px-6 py-8 flex flex-col sm:flex-row items-center justify-between text-xs gap-4 text-center sm:text-left">

            <p>
                © 2026 PIGI Technologies Inc. All rights reserved.
            </p>

            <div class="flex items-center gap-6">

                <a href="/terms" class="hover:text-white transition">
                    Terms
                </a>

                <a href="/privacy" class="hover:text-white transition">
                    Privacy
                </a>

                <a href="/contact" class="hover:text-white transition">
                    Contact Support
                </a>

            </div>

        </div>

    </footer>

</body>
</html>
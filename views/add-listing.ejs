<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add PG | PIGI</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/output.css">
</head>

<body class="bg-gray-50 text-gray-900 min-h-screen flex flex-col antialiased selection:bg-indigo-100 selection:text-indigo-700">

    <!-- Ambient background glow -->
    <div class="fixed inset-0 overflow-hidden pointer-events-none -z-10">
        <div class="absolute -top-40 left-1/2 -translate-x-1/2 w-[48rem] h-[48rem] bg-indigo-50/60 rounded-full blur-3xl"></div>
    </div>

    <!-- Header / Navbar -->
    <header class="bg-white/80 backdrop-blur-md border-b border-gray-200/80 sticky top-0 z-20">
        <div class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
            <a href="/" class="flex items-center gap-2 group">
                
                <span class="text-xl font-bold tracking-tight text-gray-900 group-hover:text-indigo-600 transition">
                    PIGI
                </span>
            </a>
            
            <nav class="flex items-center gap-6">
                <a href="/" class="text-sm font-medium text-gray-500 hover:text-indigo-600 transition">
                    Home
                </a>
                <a href="/#listings" class="text-sm font-medium text-gray-500 hover:text-indigo-600 transition">
                    PGs
                </a>
            </nav>
        </div>
    </header>

    <!-- Main Content -->
    <main class="flex-1 flex items-center justify-center px-4 py-12">
        <div class="w-full max-w-[500px]">

            <!-- Form Card -->
            <div class="bg-white rounded-3xl border border-gray-200/80 shadow-xl shadow-gray-200/50 p-8 sm:p-10">

                <!-- Header Text -->
                <div class="text-center mb-8">
                    <div class="inline-flex items-center justify-center w-12 h-12 rounded-2xl bg-indigo-50 text-indigo-600 mb-4 shadow-inner">
                        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
                        </svg>
                    </div>
                    <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-gray-900">
                        Add a New PG
                    </h1>
                    <p class="text-sm text-gray-500 mt-2">
                        Enter property details to publish your listing on PIGI
                    </p>
                </div>

                <!-- Form -->
                <form action="/host/add-listing" method="POST" class="space-y-5">

                    <!-- PG Name -->
                    <div>
                        <label for="name" class="block text-xs font-semibold uppercase tracking-wider text-gray-700 mb-1.5 ml-0.5">
                            PG Name
                        </label>
                        <div class="relative">
                            <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none <%= (typeof errors !== 'undefined' && errors.name) ? 'text-rose-400' : 'text-gray-400' %>">
                                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 21h16.5M4.5 3h15M5.25 3v18m13.5-18v18M9 6.75h1.5m-1.5 3h1.5m-1.5 3h1.5m3-6H15m-1.5 3H15m-1.5 3H15M9 21v-3.375c0-.621.504-1.125 1.125-1.125h3.75c.621 0 1.125.504 1.125 1.125V21" />
                                </svg>
                            </span>
                            <input
                                id="name"
                                type="text"
                                name="name"
                                placeholder="e.g. Starlight Luxury Stay"
                                class="w-full pl-10 pr-4 py-3 bg-gray-50/50 border <%= (typeof errors !== 'undefined' && errors.name) ? 'border-rose-400 focus:ring-rose-500/20 focus:border-rose-500 bg-rose-50/20' : 'border-gray-200 focus:ring-indigo-600/20 focus:border-indigo-600' %> rounded-xl text-sm text-gray-900 placeholder-gray-400 focus:bg-white focus:outline-none focus:ring-2 transition"
                            >
                        </div>
                        <% if (typeof errors !== 'undefined' && errors.name) { %>
                            <p class="text-xs text-rose-500 mt-1.5 ml-0.5 flex items-center gap-1">
                                <svg class="w-3.5 h-3.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <circle cx="12" cy="12" r="9" /><line x1="12" y1="8" x2="12" y2="12" /><line x1="12" y1="16" x2="12.01" y2="16" />
                                </svg>
                                <%= errors.name %>
                            </p>
                        <% } %>
                    </div>

                    <!-- Monthly Rent -->
                    <div>
                        <label for="price" class="block text-xs font-semibold uppercase tracking-wider text-gray-700 mb-1.5 ml-0.5">
                            Monthly Rent (₹)
                        </label>
                        <div class="relative">
                            <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-base font-semibold <%= (typeof errors !== 'undefined' && errors.price) ? 'text-rose-400' : 'text-gray-400' %>">
                                ₹
                            </span>
                            <input
                                id="price"
                                type="number"
                                name="price"
                                placeholder="e.g. 8500"
                                class="w-full pl-9 pr-4 py-3 bg-gray-50/50 border <%= (typeof errors !== 'undefined' && errors.price) ? 'border-rose-400 focus:ring-rose-500/20 focus:border-rose-500 bg-rose-50/20' : 'border-gray-200 focus:ring-indigo-600/20 focus:border-indigo-600' %> rounded-xl text-sm text-gray-900 placeholder-gray-400 focus:bg-white focus:outline-none focus:ring-2 transition"
                            >
                        </div>
                        <% if (typeof errors !== 'undefined' && errors.price) { %>
                            <p class="text-xs text-rose-500 mt-1.5 ml-0.5 flex items-center gap-1">
                                <svg class="w-3.5 h-3.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <circle cx="12" cy="12" r="9" /><line x1="12" y1="8" x2="12" y2="12" /><line x1="12" y1="16" x2="12.01" y2="16" />
                                </svg>
                                <%= errors.price %>
                            </p>
                        <% } %>
                    </div>

                    <!-- Location / Sector -->
                    <div>
                        <label for="location" class="block text-xs font-semibold uppercase tracking-wider text-gray-700 mb-1.5 ml-0.5">
                            Location / Sector
                        </label>
                        <div class="relative">
                            <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none <%= (typeof errors !== 'undefined' && errors.location) ? 'text-rose-400' : 'text-gray-400' %>">
                                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
                                </svg>
                            </span>
                            <input
                                id="location"
                                type="text"
                                name="location"
                                placeholder="e.g. Sector 62, Phase 8"
                                class="w-full pl-10 pr-4 py-3 bg-gray-50/50 border <%= (typeof errors !== 'undefined' && errors.location) ? 'border-rose-400 focus:ring-rose-500/20 focus:border-rose-500 bg-rose-50/20' : 'border-gray-200 focus:ring-indigo-600/20 focus:border-indigo-600' %> rounded-xl text-sm text-gray-900 placeholder-gray-400 focus:bg-white focus:outline-none focus:ring-2 transition"
                            >
                        </div>
                        <% if (typeof errors !== 'undefined' && errors.location) { %>
                            <p class="text-xs text-rose-500 mt-1.5 ml-0.5 flex items-center gap-1">
                                <svg class="w-3.5 h-3.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <circle cx="12" cy="12" r="9" /><line x1="12" y1="8" x2="12" y2="12" /><line x1="12" y1="16" x2="12.01" y2="16" />
                                </svg>
                                <%= errors.location %>
                            </p>
                        <% } %>
                    </div>

                    <!-- Action Buttons -->
                    <div class="flex items-center gap-3 pt-3">
                        <a 
                            href="/" 
                            class="w-1/3 py-3.5 px-4 text-center text-sm font-semibold text-gray-700 bg-white hover:bg-gray-50 border border-gray-200 rounded-xl transition duration-150">
                            Cancel
                        </a>
                        <button 
                            type="submit" 
                            class="w-2/3 py-3.5 px-5 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold rounded-xl shadow-md shadow-indigo-200 transition-all duration-200 hover:-translate-y-0.5 active:translate-y-0 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2">
                            Submit Listing
                        </button>
                    </div>

                </form>

            </div>

            <!-- Footer Help/Back link -->
            <p class="text-center text-xs text-gray-400 mt-6">
                Need to review existing listings? 
                <a href="/host/dashboard" class="text-indigo-600 font-medium hover:underline">Go to host dashboard</a>
            </p>

        </div>
    </main>

</body>

</html>
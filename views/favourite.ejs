<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Favourite PGs | PIGI</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/output.css">
</head>

<body class="bg-gray-50 text-gray-900 min-h-screen flex flex-col antialiased selection:bg-indigo-100 selection:text-indigo-700">

    <!-- Ambient background light -->
    <div class="fixed inset-0 overflow-hidden pointer-events-none -z-10">
        <div class="absolute -top-40 left-1/2 -translate-x-1/2 w-[52rem] h-[52rem] bg-indigo-50/70 rounded-full blur-3xl"></div>
    </div>

    <!-- Header / Navbar -->
    <header class="bg-white/85 backdrop-blur-md border-b border-gray-200/80 sticky top-0 z-30 transition-all">
        <div class="max-w-7xl mx-auto px-6 h-18 flex items-center justify-between py-3.5">

            <!-- Brand Logo -->
            <a href="/" class="flex items-center gap-2.5 group">
                
                <div class="flex flex-col">
                    <span class="text-xl font-extrabold tracking-tight text-gray-900 group-hover:text-indigo-600 transition leading-none">
                        PIGI
                    </span>
                    <span class="text-[10px] tracking-wider font-semibold text-gray-400 uppercase mt-0.5">Stay Simple</span>
                </div>
            </a>

            <!-- Navigation Links -->
            <nav class="flex items-center gap-6">
                <a href="/" class="text-sm font-medium text-gray-600 hover:text-indigo-600 transition flex items-center gap-1.5">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
                    </svg>
                    Back to Home
                </a>
            </nav>

        </div>
    </header>

    <!-- Main Content -->
    <main class="flex-1 max-w-7xl mx-auto px-6 py-12 w-full">

        <!-- Page Header -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 mb-8 border-b border-gray-200/80">
            <div>
                <div class="inline-flex items-center gap-1.5 text-xs font-semibold text-rose-500 uppercase tracking-wider mb-1">
                    <svg class="w-3.5 h-3.5 fill-rose-500" viewBox="0 0 24 24">
                        <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
                    </svg>
                    Saved Collection
                </div>
                <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-gray-900">
                    Your Favourite PGs
                </h1>
                <p class="text-sm text-gray-500 mt-1">
                    Keep track of listings you want to revisit or contact
                </p>
            </div>

            <% if (allFav.length > 0) { %>
                <span class="inline-flex items-center gap-1.5 self-start sm:self-center px-3 py-1 rounded-full bg-indigo-50 border border-indigo-100 text-indigo-700 text-xs font-semibold">
                    <%= allFav.length %> <%= allFav.length === 1 ? 'PG saved' : 'PGs saved' %>
                </span>
            <% } %>
        </div>

        <% if (allFav.length === 0) { %>

            <!-- Empty State Card -->
            <div class="bg-white rounded-3xl border border-gray-200/80 shadow-sm p-12 sm:p-16 text-center max-w-lg mx-auto my-8">
                <div class="w-16 h-16 rounded-2xl bg-rose-50 text-rose-500 flex items-center justify-center mx-auto mb-5 shadow-inner">
                    <svg class="w-8 h-8 fill-none stroke-current" viewBox="0 0 24 24" stroke-width="1.75">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />
                    </svg>
                </div>

                <h2 class="text-xl font-bold text-gray-900">
                    No favourites yet
                </h2>

                <p class="text-sm text-gray-500 mt-2 max-w-xs mx-auto leading-relaxed">
                    Explore available properties and tap the heart icon to save places you love for later.
                </p>

                <a href="/"
                    class="inline-flex items-center gap-2 mt-6 bg-indigo-600 hover:bg-indigo-700 text-white px-6 py-3 rounded-xl font-semibold text-sm shadow-md shadow-indigo-200 transition-all duration-200 hover:-translate-y-0.5 active:translate-y-0">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
                    </svg>
                    Explore PGs
                </a>
            </div>

        <% } else { %>

            <!-- Favourite Cards Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-7">

                <% allFav.forEach(listing => { %>

                    <article class="group bg-white rounded-3xl overflow-hidden border border-gray-200/80 shadow-sm hover:shadow-xl hover:shadow-gray-200/70 transition-all duration-300 flex flex-col hover:-translate-y-1">

                        <!-- Image Section -->
                        <div class="relative h-56 w-full overflow-hidden bg-gray-100">
                            <img
                                src="/img.jpg"
                                alt="<%= listing.listing.name %>"
                                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                                onerror="this.classList.add('hidden'); this.nextElementSibling.classList.remove('hidden');"
                            >
                            
                            <!-- Fallback display if img.jpg is missing -->
                            <div class="hidden w-full h-full flex items-center justify-center bg-gray-100 text-gray-400">
                                <svg class="w-10 h-10" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 001.5-1.5V6a1.5 1.5 0 00-1.5-1.5H3.75A1.5 1.5 0 002.25 6v12a1.5 1.5 0 001.5 1.5zm10.5-11.25h.008v.008h-.008V8.25zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z" />
                                </svg>
                            </div>

                            <!-- Gradient Scrim -->
                            <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-transparent opacity-60"></div>

                            <!-- Top Tag -->
                            <div class="absolute top-3.5 left-3.5 pointer-events-none">
                                <span class="inline-flex items-center gap-1.5 bg-emerald-500/95 backdrop-blur-md text-white text-[11px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-full shadow-sm">
                                    <span class="w-1.5 h-1.5 rounded-full bg-white animate-pulse"></span>
                                    Saved
                                </span>
                            </div>

                            <!-- Remove Favourite Form Button -->
                            <form
                                action="/favourite/<%= listing.listing.id %>"
                                method="POST"
                                class="absolute top-3.5 right-3.5 z-10">

                                <button
                                    type="submit"
                                    title="Remove from favourites"
                                    class="w-9 h-9 rounded-full bg-white/90 hover:bg-white text-gray-500 hover:text-rose-600 flex items-center justify-center shadow-md transition-all duration-200 hover:scale-105 active:scale-95 group/btn"
                                    aria-label="Remove from favourites">
                                    <svg class="w-4 h-4 transition-transform group-hover/btn:rotate-90" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                                    </svg>
                                </button>

                            </form>

                            <!-- Bottom Rating Indicator -->
                            <div class="absolute bottom-3 left-3 text-white text-xs font-medium flex items-center gap-1 drop-shadow">
                                <svg class="w-3.5 h-3.5 text-amber-300 fill-amber-300" viewBox="0 0 20 20">
                                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                                </svg>
                                <span class="font-bold">4.5</span>
                                <span class="text-white/80">(Verified)</span>
                            </div>
                        </div>

                        <!-- Card Body -->
                        <div class="p-6 flex-1 flex flex-col justify-between">

                            <div>
                                <!-- PG Title -->
                                <h2 class="text-lg font-bold text-gray-900 group-hover:text-indigo-600 transition leading-snug line-clamp-1">
                                    <%= listing.listing.name %>
                                </h2>

                                <!-- Location -->
                                <p class="text-xs text-gray-500 mt-1.5 flex items-center gap-1.5">
                                    <svg class="w-4 h-4 text-indigo-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
                                    </svg>
                                    <span class="truncate"><%= listing.listing.location %></span>
                                </p>

                                <!-- Facility Quick Info -->
                                <div class="grid grid-cols-2 gap-2 mt-5 text-xs text-gray-600">
                                    <div class="bg-gray-50 border border-gray-100 rounded-xl px-3 py-2 flex items-center gap-2">
                                        <span class="text-sm">🛏️</span>
                                        <div>
                                            <div class="text-[10px] text-gray-400 uppercase font-semibold leading-none">Sharing</div>
                                            <div class="font-medium mt-0.5">Flexible</div>
                                        </div>
                                    </div>
                                    <div class="bg-gray-50 border border-gray-100 rounded-xl px-3 py-2 flex items-center gap-2">
                                        <span class="text-sm">⚡</span>
                                        <div>
                                            <div class="text-[10px] text-gray-400 uppercase font-semibold leading-none">Utilities</div>
                                            <div class="font-medium mt-0.5">Included</div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Price & CTA -->
                            <div class="pt-5 mt-6 border-t border-gray-100 flex items-center justify-between">
                                <div>
                                    <span class="text-[10px] font-semibold uppercase tracking-wider text-gray-400 block">Rent / Mo</span>
                                    <div class="text-xl font-black text-indigo-600 leading-tight">
                                        ₹<%= listing.listing.price %>
                                        <span class="text-xs font-normal text-gray-400">/mo</span>
                                    </div>
                                </div>

                                <a href="/allList/<%= listing.listing.id %>"
                                    class="inline-flex items-center gap-1.5 bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2.5 rounded-xl text-xs font-semibold shadow-sm shadow-indigo-200 transition-all hover:gap-2">
                                    View Details
                                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
                                    </svg>
                                </a>
                            </div>

                        </div>

                    </article>

                <% }) %>

            </div>

        <% } %>

    </main>

    <!-- Footer -->
    <footer class="bg-gray-900 text-gray-400 border-t border-gray-800 mt-20">
        <div class="max-w-7xl mx-auto px-6 py-8 flex flex-col sm:flex-row items-center justify-between text-xs gap-4 text-center sm:text-left">
            <p>© 2026 PIGI Technologies Inc. All rights reserved.</p>
            <div class="flex items-center gap-6">
                <a href="/terms" class="hover:text-white transition">Terms</a>
                <a href="/privacy" class="hover:text-white transition">Privacy</a>
                <a href="/help" class="hover:text-white transition">Help Center</a>
            </div>
        </div>
    </footer>

</body>

</html>
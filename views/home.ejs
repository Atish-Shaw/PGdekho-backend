<!DOCTYPE html>
<html lang="en" class="scroll-smooth">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PIGI — Find Your Perfect PG & Student Accommodation</title>

    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/output.css">
</head>

<body class="bg-gray-50 text-gray-900 min-h-screen flex flex-col antialiased selection:bg-indigo-100 selection:text-indigo-700">

    <!-- Ambient background light -->
    <div class="fixed inset-0 overflow-hidden pointer-events-none -z-10">
        <div class="absolute -top-40 left-1/2 -translate-x-1/2 w-[52rem] h-[52rem] bg-indigo-50/70 rounded-full blur-3xl"></div>
    </div>

    <!-- Header / Navbar -->
    <!-- Header / Navbar -->
    <header class="bg-white/90 backdrop-blur-md border-b border-gray-200/80 sticky top-0 z-40 transition-all">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 h-20 flex items-center justify-between gap-4">

            <!-- Left: Brand Logo + Primary Nav Links -->
            <div class="flex items-center gap-8">
                
                <!-- Brand Logo -->
                <a href="/" class="flex items-center gap-2.5 group shrink-0">
                    <div class="w-9 h-9 rounded-xl bg-indigo-600 flex items-center justify-center text-white font-black text-lg shadow-sm shadow-indigo-200 group-hover:bg-indigo-700 transition">
                        P
                    </div>
                    <div class="flex flex-col">
                        <span class="text-xl font-extrabold tracking-tight text-gray-900 group-hover:text-indigo-600 transition leading-none">
                            PIGI
                        </span>
                        <span class="text-[10px] tracking-wider font-semibold text-gray-400 uppercase mt-0.5">
                            Stay Simple
                        </span>
                    </div>
                </a>

                <!-- Primary Nav Links -->
                <nav class="hidden md:flex items-center gap-1 text-sm font-semibold text-gray-600">
                    <a href="/" class="px-3 py-2 rounded-xl text-indigo-600 hover:text-indigo-700 hover:bg-indigo-50/60 transition">
                        Home
                    </a>
                    <a href="#listings" class="px-3 py-2 rounded-xl hover:text-indigo-600 hover:bg-gray-100/70 transition">
                        Browse PGs
                    </a>

                    <% if (user && user.role === 'user') { %>
                        <a href="/favourite" class="px-3 py-2 rounded-xl hover:text-indigo-600 hover:bg-rose-50/60 transition flex items-center gap-1.5 text-gray-600 hover:text-rose-600">
                            <svg class="w-4 h-4 text-rose-500 fill-rose-500/20 shrink-0" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />
                            </svg>
                            <span>Favourites</span>
                        </a>
                    <% } %>
                </nav>

            </div>

            <!-- Right: Role Actions & User Controls -->
            <div class="flex items-center gap-3">

                <% if (user) { %>

                    <!-- Host Controls -->
                    <% if (user.role === 'host') { %>
                        <div class="flex items-center gap-2">
                            <a href="/host/my-listings"
                                class="inline-flex items-center gap-2 h-10 px-3.5 rounded-xl text-sm font-semibold text-gray-700 hover:text-indigo-600 hover:bg-indigo-50/60 border border-gray-200 hover:border-indigo-100 transition-all">
                                <svg class="w-4 h-4 text-indigo-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
                                </svg>
                                <span>My PGs</span>
                                <span class="text-[10px] font-bold text-indigo-600 bg-indigo-100/80 px-1.5 py-0.5 rounded-md">
                                    Host
                                </span>
                            </a>

                            <a href="/host/add-listing"
                                class="hidden sm:inline-flex items-center gap-1.5 h-10 px-3.5 rounded-xl text-sm font-semibold text-indigo-600 bg-indigo-50 hover:bg-indigo-100 border border-indigo-200/60 transition">
                                <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                                </svg>
                                <span>Add PG</span>
                            </a>
                        </div>
                    <% } %>

                    <!-- Vertical Divider between actions and profile -->
                    <div class="h-6 w-px bg-gray-200 hidden sm:block"></div>

                    <!-- User Pill Badge -->
                    <div class="hidden sm:flex items-center gap-2 pl-1">
                        <div class="w-8 h-8 rounded-full bg-indigo-100 text-indigo-700 font-bold text-xs flex items-center justify-center border border-indigo-200">
                            <%= user.name.charAt(0).toUpperCase() %>
                        </div>
                        <span class="text-sm font-semibold text-gray-800 max-w-[130px] truncate">
                            <%= user.name %>
                        </span>
                    </div>

                    <!-- Logout Button -->
                    <form action="/logout" method="POST" class="inline-flex m-0">
                        <button type="submit"
                            class="inline-flex items-center justify-center h-10 px-4 rounded-xl text-sm font-semibold text-gray-700 hover:text-rose-600 hover:bg-rose-50 border border-gray-200 hover:border-rose-200 transition-all">
                            Logout
                        </button>
                    </form>

                <% } else { %>

                    <!-- Logged out: Login Button -->
                    <a href="/login"
                        class="inline-flex items-center justify-center h-10 px-5 rounded-xl text-sm font-semibold text-white bg-indigo-600 hover:bg-indigo-700 shadow-sm shadow-indigo-200 transition-all hover:-translate-y-0.5 active:translate-y-0">
                        Login
                    </a>

                <% } %>

            </div>

        </div>
    </header>

    <!-- Hero Section -->
    <section class="relative bg-gradient-to-b from-indigo-600 to-indigo-700 text-white pt-20 pb-28 px-6 overflow-hidden">

        <!-- Subtle Pattern Decor -->
        <div class="absolute inset-0 opacity-10 bg-[radial-gradient(#fff_1px,transparent_1px)] [background-size:16px_16px] pointer-events-none"></div>

        <div class="relative max-w-4xl mx-auto text-center">

            <div class="inline-flex items-center gap-2 bg-white/10 backdrop-blur-md border border-white/20 px-3.5 py-1.5 rounded-full text-xs font-medium text-indigo-100 mb-6 shadow-sm">
                <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                Verified PGs with no broker fees
            </div>

            <h1 class="text-4xl sm:text-5xl md:text-6xl font-black tracking-tight leading-tight mb-5">
                Find Your Perfect PG, <br class="hidden sm:inline">
                <span class="text-indigo-200">Feels Just Like Home</span>
            </h1>

            <p class="text-indigo-100/90 text-base sm:text-lg max-w-2xl mx-auto font-normal leading-relaxed mb-10">
                Discover comfortable, clean, and budget-friendly paying guest stays near universities, tech parks, and transit hubs.
            </p>

            <!-- Search / Filter Island -->
            <div class="bg-white p-2.5 sm:p-3 rounded-2xl shadow-xl shadow-indigo-950/20 border border-indigo-200/40 max-w-2xl mx-auto text-gray-800">

                <div class="flex flex-col sm:flex-row items-center gap-2">

                    <div class="relative flex-1 w-full">

                        <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-gray-400">
                            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
                            </svg>
                        </span>

                        <input
                            type="text"
                            placeholder="Search by city, sector, or landmark..."
                            class="w-full pl-10 pr-4 py-3 bg-gray-50 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-indigo-600/20 focus:border-indigo-600 transition"
                        >

                    </div>

                    <a href="#listings"
                        class="w-full sm:w-auto px-6 py-3 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl text-sm font-semibold transition shadow-md shadow-indigo-200 text-center whitespace-nowrap">
                        Search PGs
                    </a>

                </div>
            </div>

        </div>
    </section>

    <!-- Listings Section -->
    <main id="listings" class="flex-1 max-w-7xl mx-auto px-6 py-16 -mt-10">

        <!-- Header Controls -->
        <div class="bg-white rounded-2xl border border-gray-200/80 p-6 shadow-sm mb-10 flex flex-col md:flex-row md:items-center justify-between gap-4">

            <div>
                <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-gray-900">
                    Available PGs
                </h2>

                <p class="text-sm text-gray-500 mt-1">
                    Hand-picked stays inspected for hygiene, safety, and amenities
                </p>
            </div>

            <div class="flex items-center gap-3">
                <span class="text-xs font-semibold uppercase tracking-wider text-gray-400">
                    Sort by:
                </span>

                <select class="bg-gray-50 border border-gray-200 text-sm rounded-xl px-3 py-2 text-gray-700 font-medium focus:outline-none focus:ring-2 focus:ring-indigo-600/20 focus:border-indigo-600">
                    <option>Recommended</option>
                    <option>Price: Low to High</option>
                    <option>Price: High to Low</option>
                    <option>Top Rated</option>
                </select>
            </div>

        </div>

        <!-- Listing Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-7">

            <% allList.forEach(listing => { %>

                <!-- Listing Card -->
                <article class="group bg-white rounded-3xl overflow-hidden border border-gray-200/80 shadow-sm hover:shadow-xl hover:shadow-gray-200/70 transition-all duration-300 flex flex-col hover:-translate-y-1">

                    <!-- Image Thumbnail with Overlays -->
                    <div class="relative h-56 w-full overflow-hidden bg-gray-100">

                        <img
                            src="/img.jpg"
                            alt="<%= listing.name %>"
                            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                        >

                        <!-- Gradient Scrim -->
                        <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-transparent opacity-60"></div>

                        <!-- Top Badges -->
                        <div class="absolute top-3.5 left-3.5 right-3.5 flex items-center justify-between pointer-events-none">

                            <span class="inline-flex items-center gap-1.5 bg-emerald-500/95 backdrop-blur-md text-white text-[11px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-full shadow-sm">
                                <span class="w-1.5 h-1.5 rounded-full bg-white animate-pulse"></span>
                                Available
                            </span>

                            <% if (user && user.role === 'user') { %>

                                <button
                                    type="button"
                                    class="pointer-events-auto w-9 h-9 rounded-full bg-white/90 hover:bg-white text-gray-700 hover:text-rose-500 flex items-center justify-center shadow-md transition-colors"
                                    aria-label="Add to favourites">

                                    <svg class="w-4 h-4 fill-none hover:fill-rose-500 transition-colors" viewBox="0 0 24 24"
                                        stroke="currentColor" stroke-width="2">

                                        <path stroke-linecap="round" stroke-linejoin="round"
                                            d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />

                                    </svg>
                                </button>

                            <% } %>

                        </div>

                        <!-- Bottom Tag -->
                        <div class="absolute bottom-3 left-3 text-white text-xs font-medium flex items-center gap-1 drop-shadow">

                            <svg class="w-3.5 h-3.5 text-amber-300 fill-amber-300" viewBox="0 0 20 20">
                                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                            </svg>

                            <span class="font-bold">4.5</span>
                            <span class="text-white/80">(24 reviews)</span>

                        </div>

                    </div>

                    <!-- Card Body -->
                    <div class="p-6 flex-1 flex flex-col justify-between">

                        <div>

                            <!-- PG Title -->
                            <h3 class="text-lg font-bold text-gray-900 group-hover:text-indigo-600 transition leading-snug line-clamp-1">
                                <%= listing.name %>
                            </h3>

                            <!-- Location -->
                            <p class="text-xs text-gray-500 mt-1.5 flex items-center gap-1.5">

                                <svg class="w-4 h-4 text-indigo-500 shrink-0" fill="none" viewBox="0 0 24 24"
                                    stroke="currentColor" stroke-width="2">

                                    <path stroke-linecap="round" stroke-linejoin="round"
                                        d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />

                                    <path stroke-linecap="round" stroke-linejoin="round"
                                        d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />

                                </svg>

                                <span class="truncate">
                                    <%= listing.location %>
                                </span>

                            </p>

                            <!-- Facility Chips -->
                            <div class="grid grid-cols-2 gap-2 mt-5 text-xs text-gray-600">

                                <div class="bg-gray-50 border border-gray-100 rounded-xl px-3 py-2 flex items-center gap-2">

                                    <span class="text-sm">🛏️</span>

                                    <div>
                                        <div class="text-[10px] text-gray-400 uppercase font-semibold leading-none">
                                            Sharing
                                        </div>

                                        <div class="font-medium mt-0.5">
                                            Private & 2-Share
                                        </div>
                                    </div>

                                </div>

                                <div class="bg-gray-50 border border-gray-100 rounded-xl px-3 py-2 flex items-center gap-2">

                                    <span class="text-sm">⚡</span>

                                    <div>
                                        <div class="text-[10px] text-gray-400 uppercase font-semibold leading-none">
                                            WiFi & AC
                                        </div>

                                        <div class="font-medium mt-0.5">
                                            High Speed
                                        </div>
                                    </div>

                                </div>

                            </div>

                        </div>

                        <!-- Price & CTA -->
                        <div class="pt-5 mt-6 border-t border-gray-100 flex items-center justify-between">

                            <div>

                                <span class="text-[10px] font-semibold uppercase tracking-wider text-gray-400 block">
                                    Rent / Mo
                                </span>

                                <div class="text-xl font-black text-indigo-600 leading-tight">
                                    ₹<%= listing.price %>
                                    <span class="text-xs font-normal text-gray-400">/mo</span>
                                </div>

                            </div>

                            <a href="/allList/<%= listing.id %>"
                                class="inline-flex items-center gap-1.5 bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2.5 rounded-xl text-xs font-semibold shadow-sm shadow-indigo-200 transition-all hover:gap-2">

                                View Details

                                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"
                                    stroke-width="2.5">

                                    <path stroke-linecap="round" stroke-linejoin="round"
                                        d="M8.25 4.5l7.5 7.5-7.5 7.5" />

                                </svg>

                            </a>

                        </div>

                    </div>

                </article>

            <% }) %>

        </div>

    </main>

    <!-- Footer -->
    <footer class="bg-gray-900 text-gray-400 border-t border-gray-800 mt-20">

        <div class="max-w-7xl mx-auto px-6 py-12">

            <div class="flex flex-col sm:flex-row items-center justify-between gap-6 pb-8 border-b border-gray-800 text-center sm:text-left">

                <div class="flex items-center gap-2.5">

                    <div class="w-8 h-8 rounded-lg bg-indigo-600 flex items-center justify-center text-white font-black text-sm">
                        P
                    </div>

                    <span class="text-lg font-bold text-white tracking-tight">
                        PIGI
                    </span>

                </div>

                <div class="flex items-center gap-6 text-sm">

                    <a href="/about" class="hover:text-white transition">About</a>
                    <a href="/terms" class="hover:text-white transition">Terms</a>
                    <a href="/privacy" class="hover:text-white transition">Privacy</a>
                    <a href="/contact" class="hover:text-white transition">Contact</a>

                </div>

            </div>

            <div class="pt-8 flex flex-col sm:flex-row items-center justify-between text-xs gap-4 text-center sm:text-left">

                <p>© 2026 PIGI Technologies Inc. All rights reserved.</p>
                <p class="text-gray-500">Made for students and young professionals.</p>

            </div>

        </div>

    </footer>

</body>

</html>
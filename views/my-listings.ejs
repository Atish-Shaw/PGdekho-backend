<!DOCTYPE html>

<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>My PGs | Host Dashboard | PIGI</title>

    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>

    <link rel="stylesheet" href="/output.css">
</head>

<body class="bg-gray-50 text-gray-900 min-h-screen flex flex-col antialiased selection:bg-indigo-100 selection:text-indigo-700">

    <!-- Ambient background light -->
    <div class="fixed inset-0 overflow-hidden pointer-events-none -z-10">

        <div class="absolute -top-40 left-1/2 -translate-x-1/2 w-[52rem] h-[52rem] bg-indigo-50/70 rounded-full blur-3xl"></div>

    </div>


    <!-- Header / Navbar -->
    <header class="bg-white/85 backdrop-blur-md border-b border-gray-200/80 sticky top-0 z-30 transition-all">

        <div class="max-w-7xl mx-auto px-6 h-18 flex items-center justify-between py-3.5">

            <!-- Brand Logo -->
            <a href="/" class="flex items-center gap-2.5 group">
                <div class="flex justify-center gap-1.5">

                    <span class="text-xl font-extrabold tracking-tight text-gray-900 group-hover:text-indigo-600 transition leading-none">
                        PIGI
                    </span>

                    <span class="text-[10px] font-bold uppercase tracking-wider text-indigo-600 bg-indigo-50 px-1 py-0.5 ml-1 rounded border border-indigo-100">
                        Host
                    </span>

                </div>

            </a>


            <!-- Navigation Links & CTA -->
            <nav class="flex items-center gap-4 sm:gap-6">

                <a href="/" class="text-sm font-medium text-gray-600 hover:text-indigo-600 transition hidden sm:inline-block">
                    Explore App
                </a>

                <a href="/host/add-listing"
                    class="inline-flex items-center gap-1.5 bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded-xl text-sm font-semibold shadow-sm shadow-indigo-200 transition-all duration-200 hover:-translate-y-0.5 active:translate-y-0">

                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">

                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />

                    </svg>

                    <span>Add New PG</span>

                </a>

            </nav>

        </div>

    </header>


    <!-- Main Content -->
    <main class="flex-1 max-w-7xl mx-auto px-6 py-12 w-full">

        <!-- Page Header & Metrics Summary -->
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 pb-8 mb-8 border-b border-gray-200/80">

            <div>

                <div class="inline-flex items-center gap-1.5 text-xs font-semibold text-indigo-600 uppercase tracking-wider mb-1">

                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">

                        <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125 1.125 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />

                    </svg>

                    Host Management

                </div>


                <h1 class="text-3xl font-extrabold tracking-tight text-gray-900">
                    My PGs
                </h1>

                <p class="text-sm text-gray-500 mt-1">
                    Manage your listed properties, monitor availability, and track prices
                </p>

            </div>


            <!-- Total Listings Pill -->
            <div class="flex items-center gap-3">

                <div class="bg-white border border-gray-200/80 rounded-2xl px-5 py-3 shadow-sm flex items-center gap-3">

                    <div class="w-10 h-10 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center">

                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">

                            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 21h16.5M4.5 3h15M5.25 3v18m13.5-18v18M9 6.75h1.5m-1.5 3h1.5m-1.5 3h1.5m3-6H15m-1.5 3H15m-1.5 3H15M9 21v-3.375c0-.621.504-1.125 1.125-1.125h3.75c.621 0 1.125 0 1.125 1.125V21" />

                        </svg>

                    </div>

                    <div>

                        <div class="text-[11px] font-semibold text-gray-400 uppercase tracking-wider">
                            Active Listings
                        </div>

                        <div class="text-xl font-black text-gray-900 leading-tight">
                            <%= myListings.length %>
                        </div>

                    </div>

                </div>

            </div>

        </div>


        <% if (myListings.length === 0) { %>

            <!-- Empty State Card -->
            <div class="bg-white rounded-3xl border border-gray-200/80 shadow-sm p-12 sm:p-16 text-center max-w-lg mx-auto my-8">

                <div class="w-16 h-16 rounded-2xl bg-indigo-50 text-indigo-600 flex items-center justify-center mx-auto mb-5 shadow-inner">

                    <svg class="w-8 h-8 fill-none stroke-current" viewBox="0 0 24 24" stroke-width="1.8">

                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />

                    </svg>

                </div>


                <h2 class="text-xl font-bold text-gray-900">
                    You haven't added any PGs yet
                </h2>

                <p class="text-sm text-gray-500 mt-2 max-w-xs mx-auto leading-relaxed">
                    List your property on PIGI to start receiving verified student and tenant leads.
                </p>


                <a href="/host/add-listing"
                    class="inline-flex items-center gap-2 mt-6 bg-indigo-600 hover:bg-indigo-700 text-white px-6 py-3 rounded-xl font-semibold text-sm shadow-md shadow-indigo-200 transition-all duration-200 hover:-translate-y-0.5 active:translate-y-0">

                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">

                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />

                    </svg>

                    Add Your First PG

                </a>

            </div>


        <% } else { %>


            <!-- Listings Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-7">

                <% myListings.forEach(listing => { %>

                    <article class="group bg-white rounded-3xl overflow-hidden border border-gray-200/80 shadow-sm hover:shadow-xl hover:shadow-gray-200/70 transition-all duration-300 flex flex-col hover:-translate-y-1">


                        <!-- Image Section with Overlays -->
                        <div class="relative h-52 w-full overflow-hidden bg-gray-100">

                            <img
                                src="/img.jpg"
                                alt="<%= listing.name %>"
                                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                                onerror="this.classList.add('hidden'); this.nextElementSibling.classList.remove('hidden');"
                            >


                            <!-- Fallback if img.jpg is missing -->
                            <div class="hidden w-full h-full flex flex-col items-center justify-center bg-gray-100 text-gray-400 gap-1">

                                <svg class="w-10 h-10" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">

                                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 001.5-1.5V6a1.5 1.5 0 00-1.5-1.5H3.75A1.5 1.5 0 002.25 6v12a1.5 1.5 0 001.5 1.5zm10.5-11.25h.008v.008h-.008V8.25zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z" />

                                </svg>

                                <span class="text-[11px] font-medium text-gray-400">
                                    Photo Unavailable
                                </span>

                            </div>


                            <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-transparent opacity-60"></div>


                            <!-- Top Status Badge -->
                            <div class="absolute top-3.5 left-3.5 flex items-center gap-1.5 bg-emerald-500/95 backdrop-blur-md text-white text-[11px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-full shadow-sm">

                                <span class="w-1.5 h-1.5 rounded-full bg-white animate-pulse"></span>

                                Published

                            </div>

                        </div>


                        <!-- Card Body -->
                        <div class="p-6 flex-1 flex flex-col justify-between">

                            <div>

                                <!-- Title -->
                                <h2 class="text-lg font-bold text-gray-900 group-hover:text-indigo-600 transition leading-snug line-clamp-1">
                                    <%= listing.name %>
                                </h2>


                                <!-- Location -->
                                <p class="text-xs text-gray-500 mt-1.5 flex items-center gap-1.5">

                                    <svg class="w-4 h-4 text-indigo-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">

                                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />

                                        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />

                                    </svg>

                                    <span class="truncate">
                                        <%= listing.location %>
                                    </span>

                                </p>


                                <!-- Monthly Rent Info Box -->
                                <div class="mt-4 p-3 bg-gray-50/70 border border-gray-100 rounded-xl flex items-baseline justify-between">

                                    <span class="text-[11px] font-semibold text-gray-500 uppercase tracking-wider">
                                        Monthly Rent
                                    </span>

                                    <div class="text-lg font-black text-indigo-600">

                                        ₹<%= listing.price %>

                                        <span class="text-xs font-normal text-gray-400">
                                            /mo
                                        </span>

                                    </div>

                                </div>

                            </div>


                            <!-- Host Actions -->
                            <div class="pt-5 mt-6 border-t border-gray-100 flex items-center gap-2">


                                <!-- View Details -->
                                <a href="/allList/<%= listing.id %>"
                                    class="flex-1 py-2.5 px-3 bg-indigo-50 hover:bg-indigo-100/70 text-indigo-700 text-center text-xs font-semibold rounded-xl transition">
                                    View
                                </a>


                                <!-- Edit Button -->
                                <a href="/host/edit-listing/<%= listing.id %>"
                                    class="py-2.5 px-3 bg-gray-50 hover:bg-gray-100 text-gray-700 text-xs font-semibold rounded-xl transition border border-gray-200">
                                    Edit
                                </a>


                                <!-- Delete Form -->
                                <form action="/host/delete-listing/<%= listing.id %>" method="POST">

                                    <button type="submit"
                                        onclick="return confirm('Delete <%= listing.name %>? This action cannot be undone.');"
                                        title="Delete listing"
                                        class="p-2.5 text-gray-400 hover:text-rose-600 hover:bg-rose-50 border border-gray-200 hover:border-rose-200 rounded-xl transition"
                                        aria-label="Delete listing">

                                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">

                                            <path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12-.562c.34-.059.68-.114 1.022-.165m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0"
                                            />

                                        </svg>

                                    </button>

                                </form>

                            </div>

                        </div>

                    </article>

                <% }) %>

            </div>

        <% } %>

    </main>


    <!-- Footer -->
    <footer class="bg-gray-900 text-gray-400 border-t border-gray-800 mt-20">

        <div class="max-w-7xl mx-auto px-6 py-8 flex flex-col sm:flex-row items-center justify-between text-xs gap-4 text-center sm:text-left">

            <p>
                © 2026 PIGI Technologies Inc. All rights reserved.
            </p>

            <div class="flex items-center gap-6">

                <a href="/terms" class="hover:text-white transition">
                    Terms
                </a>

                <a href="/privacy" class="hover:text-white transition">
                    Privacy
                </a>

                <a href="/help" class="hover:text-white transition">
                    Host Support
                </a>

            </div>

        </div>

    </footer>

</body>

</html>